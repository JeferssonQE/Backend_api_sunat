# Configuración de la aplicación
APP_NAME=SUNAT Billing API
VERSION=1.0.0
LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8080

# CORS - Orígenes permitidos (separados por coma)
# Agregar aquí los dominios de tu frontend
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://tu-dominio.com

# Encriptación - Clave para desencriptar credenciales del frontend
# IMPORTANTE: Debe coincidir con VITE_ENCRYPTION_KEY del frontend
# En producción, generar una clave segura: python -c "import secrets; print(secrets.token_urlsafe(32))"
ENCRYPTION_KEY=CAMBIAR_EN_PRODUCCION

# SUNAT
SUNAT_URL=https://e-menu.sunat.gob.pe/cl-ti-itmenu/MenuInternet.htm

# Selenium
CHROME_HEADLESS=true
TASK_TIMEOUT=300
